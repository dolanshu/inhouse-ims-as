# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
testbed/sim-platform/.image-native/
.coverage
htmlcov/

# Local artefacts (captures, load reports, trace dumps)
*.log
*.pcap
*.pcapng
artifacts/
!docs/acceptance/artifacts/
captures/

# Local scratch (never committed)
tmp/
.tools/

# Infra toolchain installed by tools/bootstrap-infra.sh (versions pinned in
# tools/VERSIONS; binaries are per-machine, never committed).
tools/bin/

# M4b-8 compose TLS material (generate via deploy/compose/scripts/gen-certs.sh)
deploy/compose/certs/*
!deploy/compose/certs/.gitkeep
deploy/kind/certs/*
!deploy/kind/certs/.gitkeep
deploy/compose/.env

# Editors, OS and agent session state
.idea/
.vscode/
*.swp
.DS_Store
.workbuddy/

# Office temporary lock files
~$*

# CodeBuddy auto-generated team session state (rules/ stays tracked)
.codebuddy/teams/
